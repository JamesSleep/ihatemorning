{
  "name": "ihatemorning",
  "version": "1.0.0",
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true
}
